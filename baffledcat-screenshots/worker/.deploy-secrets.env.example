# Copy to .deploy-secrets.env and fill in (never commit .deploy-secrets.env).
#
# Required for DeployScreengrabber.cmd (non-interactive Wrangler):
CLOUDFLARE_API_TOKEN=

# Strongly recommended (avoids GET /memberships auth errors during d1/r2 create).
# From `npx wrangler whoami` Account ID column, e.g. dc9bae83e7d1233d0d8cc674dfd30197
CLOUDFLARE_ACCOUNT_ID=

# Optional / also set by the deploy script if missing:
# TICKET_HMAC_SECRET=
# ADMIN_TOKEN=
# TURNSTILE_SECRET=
